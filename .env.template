# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit real credentials.

# --- ViGGO login ---
# Your school's ViGGO subdomain, e.g. https://vibyfriskole.viggo.dk
VIGGO_BASE=
VIGGO_USER=
VIGGO_PASS=

# Device fingerprint that skips ViGGO's email 2FA on every login.
# How to get it (one-time, ~2 min):
#   1. Log into your VIGGO_BASE in a normal browser and complete the
#      email 2FA code as usual.
#   2. Open DevTools -> Application/Storage -> Local Storage -> your
#      VIGGO_BASE origin.
#   3. Copy the value of the "fingerprint" key (a GUID) into this var.
# As long as this exact value is sent on future logins, ViGGO treats it
# as the same already-verified device and skips 2FA.
VIGGO_FINGERPRINT=

# --- Notifications (ntfy.sh or self-hosted ntfy) ---
NTFY_SERVER=https://ntfy.sh
# Pick a long random topic name - anyone who knows it can read your
# notifications. Generate one with: python3 -c "import secrets; print('viggo-' + secrets.token_hex(8))"
NTFY_TOPIC=

# --- Polling ---
# How often (seconds) to check ViGGO for new items. 1800 = 30 min, 43200 = 12h.
POLL_SECONDS=1800

# Comma-separated ViGGO room IDs to watch for forum threads ("Rum" -> each
# room's URL is /Basic/Rooms/Index/<id> once you click into it).
ROOM_IDS=
# id:name pairs matching ROOM_IDS, used to label notifications.
ROOM_NAMES=
# Comma-separated bulletin board type IDs ("Opslagstavle" widget on the
# ViGGO home page links to /Basic/Home/SaveShow?functionId=Bulletin&subFunctionId=<id>).
BULLETIN_TYPE_IDS=

# --- Optional: AI triage (Claude reads the full text and flags concrete
# action items buried in long posts, e.g. "bring a deck of cards by week 41").
# Leave ANTHROPIC_API_KEY empty to disable - you'll still get raw
# notifications with the full text, just without the triage.
# Get a key at https://console.anthropic.com (pay-as-you-go, pennies/month
# at normal volume - check their billing page for current minimums).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Optional: dead man's switch ---
# Ping URL from a free monitor (e.g. https://healthchecks.io) that the app
# calls after every successful cycle. If it stops hearing from the app, the
# monitor itself alerts you - this catches cases an in-app alert can't
# (the whole container dying, or ntfy itself being down).
# Leave empty to disable.
HEALTHCHECK_URL=
